TELEGRAM_BOT_TOKEN=your_bot_token_here

# Firebase Admin service account JSON.
# You can provide raw JSON on one line or base64-encoded JSON.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Public QuestFlow URL opened from the bot.
QUESTFLOW_WEB_URL=https://velo-app.web.app

# Minimum discount percentage required for automatic wishlist alerts.
MIN_DISCOUNT_PERCENT=5
